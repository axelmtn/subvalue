{
  "name": "subvalue-workspace",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "workspaces": [
    "packages/cli"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "start": "node --disable-warning=ExperimentalWarning packages/cli/dist/cli.js",
    "demo": "npm run start -- --demo --no-open",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run build && npm test",
    "pack:cli": "npm pack --workspace @subvalue/cli --ignore-scripts --pack-destination artifacts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "playwright": "^1.56.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
